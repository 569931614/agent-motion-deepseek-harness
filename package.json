{
  "name": "agent-motion",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "description": "Agent-driven Three.js video production and native DeepSeek Harness skills bundle.",
  "main": "./deepseek/lib/index.js",
  "exports": {
    ".": "./deepseek/lib/index.js",
    "./client": "./deepseek/lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    ".env.example",
    "deepseek/",
    "templates/",
    "cordis.patch.yml",
    ".agents/",
    "scripts/",
    "tests/",
    "serve.mjs",
    "reference-library/typography/",
    "reference-library/analysis/",
    "AGENTS.md",
    "NOTICE",
    "COMMERCIAL-LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    ".gitignore",
    "inputs/README.md",
    "docs/getting-started.md",
    "docs/compatibility.md",
    "docs/deepseek-harness.md",
    "docs/deployment.md",
    "docs/user-manual.md",
    "docs/image-generation.md",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "serve": "node serve.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "read-stage": "node scripts/read-stage.mjs",
    "test": "node scripts/test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "package:check": "node scripts/package-release.mjs --check",
    "package:release": "node scripts/package-release.mjs",
    "onboard": "node scripts/bootstrap.mjs",
    "matte": "node scripts/matte.mjs",
    "matting:smoke": "node scripts/matting-smoke.mjs",
    "test:plugin": "node --test deepseek/plugin.test.mjs deepseek/pipeline.test.mjs deepseek/image.test.mjs deepseek/web.test.mjs deepseek/client.test.mjs deepseek/voice.test.mjs deepseek/avatar.test.mjs deepseek/clone.test.mjs deepseek/rules.test.mjs deepseek/project.test.mjs",
    "build": "tsc -p deepseek/tsconfig.json",
    "prepack": "npm run build",
    "produce": "node deepseek/lib/produce.js",
    "image": "node deepseek/lib/image.js"
  },
  "dependencies": {
    "opencc-js": "1.4.2",
    "playwright-core": "1.63.0",
    "three": "0.186.0",
    "ws": "8.18.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2",
    "@types/node": "22.19.1",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "SEE LICENSE IN LICENSE"
}
