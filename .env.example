# Server-side compatibility for standalone provider CLI scripts only.
# Harness Web uses Settings -> 动效工坊; no .env file or Web restart is needed.
# A standalone script must explicitly load its process environment; this file is not loaded automatically.
# Beijing DashScope key. Video voice mode creates its own cosyvoice-v3.5-plus ID.
DASHSCOPE_API_KEY=
# Optional default for the existing voice ID mode.
COSYVOICE_VOICE_ID=
YIDEVS_API_KEY=
# Tencent Cloud COS private bucket. Internal MOTION_OSS_* names are retained for compatibility.
# Region is derived from the COS endpoint; no separate region variable is needed.
MOTION_OSS_ENDPOINT=https://cos.ap-beijing.myqcloud.com
# Full COS bucket name including APPID, for example motion-assets-1250000000.
MOTION_OSS_BUCKET=
# Tencent Cloud COS SecretId / SecretKey. Scope PutObject and GetObject to the needed objects.
MOTION_OSS_ACCESS_KEY_ID=
MOTION_OSS_ACCESS_KEY_SECRET=
# Optional COS SessionToken when using Tencent Cloud STS temporary credentials.
MOTION_OSS_SECURITY_TOKEN=
